{
  "constraint_id": "P4_L5",
  "policy_id": "P4",
  "description": "The return request must be within the applicable return window.",
  "required_fields": [
    "delivery_date",
    "request_date",
    "applicable_return_window"
  ],
  "evaluation": "date_difference <= applicable_return_window",
  "possible_status": [
    "SATISFIED",
    "VIOLATED",
    "UNCERTAIN"
  ],
  "on_satisfied": "continue_evaluation",
  "on_violated": "check_exceptions_or_reject",
  "on_uncertain": "retrieve_policy_or_escalate"
}
